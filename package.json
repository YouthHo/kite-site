    "build:gh": "node scripts/build-gh.cjs",
    "preview": "vite preview",
    "postbuild": "node scripts/perf-check.cjs",
    "validate": "node scripts/check-bom.cjs && node scripts/validate-data.cjs",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
