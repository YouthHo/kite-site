    "@fontsource/noto-serif-sc": "^5.2.8",
    "echarts": "^5.5.1",
    "gsap": "^3.12.5",
    "lucide-vue-next": "^0.453.0",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "sass": "^1.78.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  }
