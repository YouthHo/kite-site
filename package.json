{
  "name": "kite-2017-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "description": "《风筝》(2017) 影视专题静态站 — 电影级谍战沉浸体验",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-case.cjs && node scripts/check-bom.cjs && node scripts/validate-data.cjs && node scripts/gen-sitemap.cjs",
